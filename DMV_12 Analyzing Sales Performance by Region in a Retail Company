import pandas as pd
import matplotlib.pyplot as plt

# Step 1: Load dataset directly from URL
dataset_url = (
    "https://raw.githubusercontent.com/shivareddy2002/"
    "Retail-Sales-Data-Pipeline/main/data/retail_sales_raw.csv"
)

df = pd.read_csv(dataset_url)

print("Dataset loaded successfully!")
print("Dataset link:", dataset_url)

# Step 2: Explore the dataset
print("\nFirst five records:")
print(df.head())

print("\nDataset information:")
df.info()

print("\nMissing values:")
print(df.isnull().sum())

# Step 3: Identify relevant variables and clean data
df.columns = df.columns.str.strip().str.lower()

df["sales"] = pd.to_numeric(df["sales"], errors="coerce")
df["region"] = df["region"].astype("string").str.strip()
df["category"] = df["category"].astype("string").str.strip()

df = df.dropna(subset=["region", "category", "sales"])
df = df.drop_duplicates()

# Step 4: Calculate total sales by region
sales_by_region = (
    df.groupby("region")["sales"]
    .sum()
    .sort_values(ascending=False)
)

print("\nTotal Sales by Region:")
print(sales_by_region)

# Step 5: Bar chart and pie chart of regional sales
sales_by_region.plot(kind="bar", figsize=(8, 5))
plt.title("Total Sales by Region")
plt.xlabel("Region")
plt.ylabel("Total Sales")
plt.tight_layout()
plt.show()

sales_by_region.plot(kind="pie", autopct="%1.1f%%", figsize=(7, 7))
plt.title("Sales Distribution by Region")
plt.ylabel("")
plt.tight_layout()
plt.show()

# Step 6: Identify the top-performing region
top_region = sales_by_region.idxmax()
print("\nTop-Performing Region:", top_region)
print("Total Sales:", sales_by_region.max())

# Step 7: Calculate sales by region and product category
region_category_sales = df.pivot_table(
    index="region",
    columns="category",
    values="sales",
    aggfunc="sum",
    fill_value=0
)

print("\nSales by Region and Category:")
print(region_category_sales)

# Step 8: Stacked bar chart for comparison
region_category_sales.plot(
    kind="bar", stacked=True, figsize=(9, 5)
)
plt.title("Sales by Region and Product Category")
plt.xlabel("Region")
plt.ylabel("Total Sales")
plt.legend(title="Category")
plt.tight_layout()
plt.show()

print("\nSales aggregation and visualization completed successfully.")
